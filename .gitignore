# Everything listed here is either regenerable, machine-local, or private.
# Nothing the project needs to run or read as a portfolio piece belongs here:
# src/, tests/, notebooks/, data/raw/, data/processed/ and reports/figures/
# stay tracked on purpose.

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/
.Python

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
.pytype/
.cache/

